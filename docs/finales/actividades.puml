title Registro e inicio de sesión

|#EFF7F0|Usuario|
|#FDFDFD|API Milpa|
|#EFF7F0|Base de datos|

|Usuario|
start
:Completar registro\n(email, nombre, contraseña, teléfono, rol);

|API Milpa|
if (¿El rol está entre 1 y 4?) then (No)
  :Responder 400 invalid input;
  stop
else (Sí)
endif
if (¿Campos completos y contraseñas coinciden?) then (No)
  :Responder 400 de validación;
  stop
else (Sí)
endif

|Base de datos|
:Verificar que el correo no exista;
|API Milpa|
if (¿El correo ya está registrado?) then (Sí)
  :Responder 409 email already registered;
  stop
else (No)
  :Crear usuario con contraseña cifrada (bcrypt);
  :Responder 201 Created;
endif

|Usuario|
:Enviar credenciales (email, contraseña);
|API Milpa|
if (¿El usuario existe?) then (No)
  :Responder 404;
  stop
else (Sí)
endif
if (¿La contraseña es correcta?) then (No)
  :Responder 401 unauthorized;
  stop
else (Sí)
  :Emitir JWT HS256 (24 h)\ncon id de usuario y rol;
  :Responder 200 con access_token;
endif
:Validar el token en cada solicitud protegida;
if (¿El token es válido y está vigente?) then (No)
  :Responder 401 invalid or expired token;
  stop
else (Sí)
endif
if (¿La cuenta está suspendida?) then (Sí)
  :Responder 403 cuenta suspendida;
  stop
else (No)
  :Procesar la solicitud;
endif
stop
@enduml

